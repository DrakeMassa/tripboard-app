# Client-visible identifiers from Supabase Dashboard > Connect.
# The publishable key is safe in the app only when Row Level Security is correct.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Browser-visible Google Maps key. Restrict it to the Wanderly domains and to
# Maps JavaScript API + Places API (New). Never reuse a server-side key here.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_restricted_browser_key
# Optional Cloud-based map style ID. DEMO_MAP_ID is used when omitted.
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=replace_with_map_id

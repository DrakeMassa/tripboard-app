# Client-visible identifiers from Supabase Dashboard > Connect.
# The publishable key is safe in the app only when Row Level Security is correct.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Wanderly defaults to its no-key OpenStreetMap experience. This setting is
# optional because `openstreetmap` is also the code default.
EXPO_PUBLIC_MAP_PROVIDER=openstreetmap

# Paid Google Maps is intentionally opt-in. Leave these commented out for the
# zero-billing pilot. If it is ever approved, restrict the browser key by HTTPS
# referrer and API, then set EXPO_PUBLIC_MAP_PROVIDER=google.
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=replace_with_restricted_browser_key
# EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=replace_with_map_id
